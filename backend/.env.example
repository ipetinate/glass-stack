# Local development only. Shell environment variables take precedence.
GLASS_UNSPLASH_ACCESS_KEY=
GLASS_UNSPLASH_SELF_HOST=false

# Docker engine host. When unset, falls back to DOCKER_HOST, then auto-detects
# platform sockets (Docker Desktop/Colima/OrbStack on macOS, /var/run/docker.sock on Linux).
# Examples: unix:///var/run/docker.sock, ssh://user@host, npipe:////./pipe/docker_engine
GLASS_DOCKER_HOST=
